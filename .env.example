FRONTEND_HOST_PORT=15173
VITE_PORT=5173
VITE_API_BASE_URL=http://localhost:18100
# Required for CARTO raster basemaps (watermarked without a key).
# Request a free key at https://carto.com/basemaps/apikey
VITE_CARTO_API_KEY=
# Baked in at `npm run build` — set in production CI so events/replays work.
# VITE_PUBLIC_POSTHOG_TOKEN=phc_...
# VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Auth0 SPA settings come from GET /subscriptions/auth/config (backend AUTH0_*).
# Do not hardcode Auth0 domain/client in the frontend for v1.

# Local dogfood only (optional): skip Auth0 and use Bearer dev:alice
# VITE_SUBSCRIPTIONS_ALLOW_DEV_AUTH=1
# VITE_SUBSCRIPTIONS_DEV_TOKEN=dev:alice

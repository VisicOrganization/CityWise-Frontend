FRONTEND_HOST_PORT=15173
VITE_PORT=5173
VITE_API_BASE_URL=http://localhost:18100
# Optional: read council-file (project) pins and detail from a different backend than the one
# above. The CD2 neighborhoods demo needs this, because a local database has no projects and the
# legislation pins would otherwise be missing. Everything else keeps using VITE_API_BASE_URL.
# VITE_PROJECTS_API_BASE_URL=https://dev.api.citywise.app
# Required for CARTO raster basemaps (watermarked without a key).
# Request a free key at https://carto.com/basemaps/apikey
VITE_CARTO_API_KEY=
# Baked in at `npm run build` — set in production CI so events/replays work.
# VITE_PUBLIC_POSTHOG_TOKEN=phc_...
# VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
